public class LengthOfLastWordOptimized {

    public static int lengthOfLastWord(String s) {

        // Start from the last character
        int i = s.length() - 1;

        int count = 0;

        // Step 1: Skip spaces at the end
        while (i >= 0 && s.charAt(i) == ' ') {
            i--;
        }

        // Step 2: Count characters of the last word
        while (i >= 0 && s.charAt(i) != ' ') {
            count++;
            i--;
        }

        return count;
    }

    public static void main(String[] args) {

        String s = "Hello World";

        int result = lengthOfLastWord(s);

        System.out.println("Length of last word: " + result);
    }
}


==========================================BRUTEFORCE =======================================================================
public class LengthOfLastWordBruteForce {

    public static int lengthOfLastWord(String s) {

        // Step 1: Remove spaces from beginning and end
        s = s.trim();

        // Step 2: Split string into words
        String[] words = s.split(" ");

        // Step 3: Get the last word
        String lastWord = words[words.length - 1];

        // Step 4: Return length of last word
        return lastWord.length();
    }

    public static void main(String[] args) {

        String s = "Hello World";

        int result = lengthOfLastWord(s);

        System.out.println("Length of last word: " + result);
    }
}
