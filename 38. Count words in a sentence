public class CountWords {

    // Brute Force Approach
    public static int countWordsBruteForce(String s) {

        // Remove leading and trailing spaces
        s = s.trim();

        // Split sentence into words
        String[] words = s.split("\\s+");

        // Number of words = array length
        return words.length;
    }

    public static void main(String[] args) {

        String s = "Java is very powerful";

        System.out.println("Word count: " + countWordsBruteForce(s));
    }
}


============================================Optimized Solution=============================================
public class CountWordsOptimized {

    // Optimized Approach
    public static int countWords(String s) {

        int count = 0;
        boolean insideWord = false;

        // Traverse every character
        for (int i = 0; i < s.length(); i++) {

            char ch = s.charAt(i);

            // If current character is not a space,
            // we are inside a word
            if (!Character.isWhitespace(ch)) {

                // Count only when a new word starts
                if (!insideWord) {
                    count++;
                    insideWord = true;
                }

            } else {
                // Space means the current word has ended
                insideWord = false;
            }
        }

        return count;
    }

    public static void main(String[] args) {

        String s = "Java is very powerful";

        System.out.println("Word count: " + countWords(s));
    }
}
