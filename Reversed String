public class ReverseString {
    public static void main(String[] args) {
        String name = "anaS";
        String reversed = "";
        for(int i=name.length()-1;i>=0;i--){
          reversed = reversed+name.charAt(i);
        }
        System.out.printf("Answer is :"+reversed);
    }
}


